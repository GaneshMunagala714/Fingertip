# Copy to .env on the server. Never commit .env.
DOMAIN=sign2speak.example.com
PUBLIC_URL=https://sign2speak.example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+1XXXXXXXXXX

GEMINI_API_KEY=
# The server checks these exist at startup (/api/health). Switch the reply writer to
# gemini-3.8-flash only if reply-quality tests fail.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REPLY_MODEL=
GEMINI_THINKING_LEVEL=minimal

# Voice: VOICE_ID-MODEL[-SETTINGS]. flash_v2_5 is ConversationRelay's default ElevenLabs model.
# TTS_MODEL=v4 -> "VOICE_ID-v4": no speed/SSML; audio tags like [warmly] go in the text.
TTS_MODEL=flash_v2_5
TTS_VOICE_SETTINGS=
DEFAULT_VOICE_ID=XrExE9yKIg1WjnnlVkGX

# Experimental: let facial expression set the tone (off: furrowed brows also mark ASL wh-questions).
FACE_TONE=false

# Keep true in production: checks X-Twilio-Signature on webhooks and the relay handshake.
VALIDATE_TWILIO_SIGNATURE=true

# Optional: require ?key=... on first open of the app.
APP_ACCESS_KEY=
